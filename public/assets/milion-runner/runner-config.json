    "scenes": [
      { "id": "story.first_package", "chapter": "prologue", "eyebrow": "Nasza historia", "title": "Zaczęło się od jednej paczki.", "body": ["Pierwsze zamówienie przygotowaliśmy własnymi rękami w małym sklepie i magazynie wielkości kawalerki. Tak rozpoczęła się droga AMSO."], "vignette": "first-package", "continueLabel": "Dalej" },
      { "id": "story.quality_promise", "chapter": "prologue", "eyebrow": "Nasza historia", "title": "Sprzęt z przeszłością. Sprawdzony na przyszłość.", "body": ["Każde urządzenie testujemy i przygotowujemy, zanim trafi do kolejnej osoby — sprawne, bezpieczne i gotowe do dalszej pracy."], "vignette": "tested-device", "continueLabel": "Zaczynamy" },
      { "id": "story.first_process", "chapter": "epoch_1", "eyebrow": "Nasza historia", "title": "Mały magazyn potrzebował dobrego planu.", "body": ["Rosła liczba paczek, kabli i zadań. Porządek oraz powtarzalne procesy pozwoliły nam zrobić następny krok."], "vignette": "cable-route", "continueLabel": "Poznaj historie klientów" },
      { "id": "client.creative_start", "chapter": "epoch_3", "eyebrow": "Historia klienta", "title": "Sprawdzony laptop pomógł zrobić pierwszy krok.", "body": ["Jedna z klientek zaczynała z ograniczonym budżetem. Wybrany sprzęt pozwolił jej tworzyć portfolio i rozwinąć własne miejsce pracy."], "vignette": "creative-desk", "continueLabel": "Dalej" },
      { "id": "client.business_growth", "chapter": "epoch_3", "eyebrow": "Historia klienta", "title": "Od laptopa za 300 zł do zamówienia za 300 000 zł.", "body": ["Firma klienta rosła przez lata. Zmieniły się potrzeby i budżet, ale zaufanie do sprawdzonego sprzętu zostało."], "vignette": "growing-business", "continueLabel": "Dalej" },
      { "id": "client.b2b_trust", "chapter": "epoch_3", "eyebrow": "Historia klienta", "title": "Zaczęło się od testowych 10%.", "body": ["Po siedmiu latach sprzęt poleasingowy nadal jest pierwszym wyborem tej firmy. Próba zmieniła się w trwałą współpracę."], "vignette": "long-trust", "continueLabel": "Wracamy do naszej historii" },
      { "id": "story.scale", "chapter": "epoch_4", "eyebrow": "Nasza historia", "title": "Skala potrzebuje systemu.", "body": ["Dziś magazyn AMSO ma 3 000 m², a zespół realizuje niemal 400 zamówień dziennie dzięki uporządkowanym procesom i logistyce."], "vignette": "warehouse-scale", "continueLabel": "Dalej" },
      { "id": "story.million_approach", "chapter": "epoch_5", "eyebrow": "Nasza historia", "title": "Do miliona brakowało już tylko kilku zamówień.", "body": ["Za każdą kolejną liczbą stała konkretna potrzeba: sprzęt do pracy, nauki, firmy albo realizacji własnego planu."], "vignette": "million-counter", "continueLabel": "Rozpocznij finał" },
      { "id": "challenge.million_wave", "chapter": "epoch_5", "eyebrow": "Wyzwanie", "title": "Fala Miliona sprawdza całą drogę.", "body": ["Trzy fazy łączą skok, ślizg i decyzje poznane wcześniej. Ukończ każdą kombinację, żeby dotrzeć do zamówienia numer milion."], "vignette": "million-wave", "continueLabel": "Podejmij wyzwanie" },
      { "id": "story.million_finale", "chapter": "finale", "eyebrow": "Nasza historia", "title": "Milion zamówień. Milion ludzkich planów.", "body": ["Pierwszą paczkę przygotowaliśmy sami. Do miliona dotarliśmy razem z ludźmi, którzy potrzebowali sprzętu do pracy, nauki i rozwoju. Ta droga trwa dalej."], "vignette": "million-package", "continueLabel": "Jedziemy dalej — Próba Miliona" }
    ],
