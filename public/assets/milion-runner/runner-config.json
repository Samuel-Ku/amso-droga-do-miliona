    "scenes": [
      { "id": "intro.ready", "chapter": "prologue", "eyebrow": "Pierwsza paczka", "title": "Dobra. Pierwsza gotowa.", "body": ["Zanim pojawiły się tysiące zamówień, była jedna paczka przygotowana własnymi rękami."], "vignette": "first-package", "continueLabel": "Dalej" },
      { "id": "intro.beginning", "chapter": "prologue", "eyebrow": "Początek AMSO", "title": "Kilka półek, mały magazyn i prosty pomysł.", "body": ["Dobry sprzęt może pracować dłużej — jeśli ktoś wcześniej naprawdę go sprawdzi."], "vignette": "small-warehouse", "continueLabel": "Dalej" },
      { "id": "intro.promise", "chapter": "prologue", "eyebrow": "Nasza obietnica", "title": "Dobry sprzęt nie musi być nowy. Musi być sprawdzony.", "body": ["Z tą myślą ruszamy od pierwszej paczki w stronę zamówienia numer milion."], "vignette": "tested-device", "continueLabel": "Zaczynamy" },
      { "id": "epoch_1.challenge", "chapter": "epoch_1", "eyebrow": "Pierwsze wyzwanie", "title": "Kablowy Chaos", "body": ["Miejsca było mało, więc każdy skok, ślizg i metr magazynu wymagał coraz lepszego planu."], "vignette": "cable-route", "continueLabel": "Dalej" },
      { "id": "epoch_1.resolve", "chapter": "epoch_1", "eyebrow": "Pierwsza trasa", "title": "Porządek wygrywa z chaosem.", "body": ["Nie potrzebowaliśmy większego początku. Potrzebowaliśmy procesu, który pozwoli zrobić następny krok."], "vignette": "small-warehouse", "continueLabel": "Dalej" },
      { "id": "epoch_2.setup", "chapter": "epoch_2", "eyebrow": "Drugie życie sprzętu", "title": "Używany? A jeśli przestanie działać?", "body": ["Sprzęt może mieć przeszłość i świetną przyszłość. Zaufanie zaczyna się jednak od porządnego testu."], "vignette": "tested-device", "continueLabel": "Dalej" },
      { "id": "epoch_2.resolve", "chapter": "epoch_2", "eyebrow": "Audyt jakości", "title": "SPRAWDZONY", "body": ["Drugie życie zaczyna się od pierwszego porządnego testu — i od pewności, że urządzenie jest gotowe do dalszej pracy."], "vignette": "quality-stamp", "continueLabel": "Dalej" },
      { "id": "epoch_3.people", "chapter": "epoch_3", "eyebrow": "Trzy prawdziwe historie", "title": "Za każdą paczką stoi czyjś plan.", "body": ["Praca kreatywna, rozwój firmy, decyzja zakupowa na lata. Ludzie rosną razem ze sprzętem."], "vignette": "creative-desk", "continueLabel": "Dalej" },
      { "id": "epoch_3.designer", "chapter": "epoch_3", "eyebrow": "Kreatywny start", "title": "Budżet był ograniczony. Pomysł — nie.", "body": ["Dobry start nie zawsze musi być nowy. Czasem jeden rozsądny zakup wystarcza, żeby zrobić pierwszy krok."], "vignette": "creative-desk", "continueLabel": "Dalej" },
      { "id": "epoch_3.business", "chapter": "epoch_3", "eyebrow": "Rozwój firmy", "title": "Najpierw laptop za maksymalnie 300 zł.", "body": ["Później budżet wyniósł 300 000 zł. Zmienił się biznes i skala zamówienia. Zaufanie zostało."], "vignette": "growing-business", "continueLabel": "Dalej" },
      { "id": "epoch_3.b2b", "chapter": "epoch_3", "eyebrow": "Zaufanie na lata", "title": "Zaczęło się od testowych 10%.", "body": ["Siedem lat później sprzęt poleasingowy nadal jest ich pierwszym wyborem. Rozsądny wybór nie oznacza rezygnacji z jakości."], "vignette": "long-trust", "continueLabel": "Dalej" },
      { "id": "epoch_4.scale", "chapter": "epoch_4", "eyebrow": "Skala", "title": "3 000 m² magazynu. Niemal 400 zamówień dziennie.", "body": ["Większy magazyn nie wystarczył. Skala potrzebowała coraz lepszych procesów i coraz większego zespołu."], "vignette": "warehouse-scale", "continueLabel": "Dalej" },
      { "id": "epoch_4.numbers", "chapter": "epoch_4", "eyebrow": "Rok w liczbach", "title": "Sprzęt w ciągłym ruchu", "body": ["Około 240 metrów telefonów — wyżej niż Pałac Kultury i Nauki. Około 400 000 kg komputerów PC — tyle co pięć załadowanych Boeingów 737.", "41 tys. PC · 76 tys. notebooków · 40 tys. monitorów · 28 tys. telefonów."], "vignette": "product-stream", "continueLabel": "Dalej" },
      { "id": "epoch_4.resolve", "chapter": "epoch_4", "eyebrow": "Logistyka", "title": "Każde urządzenie ma numer. Dla klienta ma historię.", "body": ["Skanery, procesy i trasy porządkują skalę. Cel pozostaje ten sam: właściwy sprzęt ma dotrzeć do właściwej osoby."], "vignette": "delivery-map", "continueLabel": "Dalej" },
      { "id": "epoch_5.approach", "chapter": "epoch_5", "eyebrow": "Droga do Miliona", "title": "Od tego zaczynałam. Zostaliśmy na lata.", "body": ["Ten sprzęt pomógł nam ruszyć. Zamówiliśmy na próbę. Każdy powrót przybliżał licznik do kolejnego symbolicznego progu."], "vignette": "million-counter", "continueLabel": "Dalej" },
      { "id": "epoch_5.wave", "chapter": "epoch_5", "eyebrow": "999 970 → 999 999", "title": "Finał: Fala Miliona", "body": ["Wszystkie poznane działania, trzy power-upy i osiem symboli drogi wracają w jednym ostatnim wyzwaniu."], "vignette": "million-wave", "continueLabel": "Dalej" },
      { "id": "final.moments", "chapter": "finale", "eyebrow": "Zamówienie nr 1 000 000", "title": "Milion zamówień to nie tylko liczba.", "body": ["To milion momentów, w których ktoś potrzebował sprzętu do pracy, nauki, firmy albo realizacji własnego planu.", "Pierwszą paczkę wysłaliśmy sami. Do miliona dotarliśmy razem."], "vignette": "million-package", "continueLabel": "Dalej" },
      { "id": "final.thanks", "chapter": "finale", "eyebrow": "AMSO", "title": "Dziękujemy za 1 000 000 zamówień.", "body": ["Sprzęt z przeszłością. Na przyszłość.", "Milion to nie koniec drogi. Od teraz każda niechroniona kolizja kończy próbę."], "vignette": "thank-you", "continueLabel": "Jedziemy dalej — Próba Miliona" }
    ],
